{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organchor.org/schemas/evidence-staleness-agent-submission.v0.1.json",
  "title": "OrgAnchor Evidence Staleness Agent Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "evaluation_time",
    "identity_continuity",
    "package_integrity",
    "package_health_status",
    "historical_record_status",
    "claim_support",
    "claim_truth",
    "fraud_assessment",
    "evidence_assessment",
    "missing_support",
    "risk_gaps",
    "next_checks",
    "artifact_refs",
    "final_policy_decision",
    "summary"
  ],
  "properties": {
    "scenario_id": { "const": "manufacturing-expired-s2-current-claim-v1" },
    "evaluation_time": { "const": "2026-07-17T00:00:00Z" },
    "identity_continuity": { "enum": ["VERIFIED", "NOT_VERIFIED", "UNKNOWN"] },
    "package_integrity": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "package_health_status": { "enum": ["FRESH", "STALE_EVIDENCE", "EXPIRED_EVIDENCE", "UNKNOWN"] },
    "historical_record_status": { "enum": ["PRESERVED", "NOT_PRESERVED", "UNKNOWN"] },
    "claim_support": { "enum": ["SUFFICIENT", "INSUFFICIENT", "CONFLICTED", "UNKNOWN"] },
    "claim_truth": { "enum": ["TRUE", "FALSE", "NOT_DETERMINED"] },
    "fraud_assessment": { "enum": ["ESTABLISHED", "NOT_ESTABLISHED", "UNKNOWN"] },
    "evidence_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "s_class", "relevance", "scope_match", "freshness", "historical_support", "current_support", "limitations"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "s_class": { "enum": ["S1", "S2", "S3", "UNKNOWN"] },
          "relevance": { "enum": ["DIRECT", "INDIRECT", "IRRELEVANT", "UNKNOWN"] },
          "scope_match": { "enum": ["MATCH", "PARTIAL", "MISMATCH", "UNKNOWN"] },
          "freshness": { "enum": ["CURRENT", "EXPIRED", "UNDATED", "UNKNOWN"] },
          "historical_support": { "enum": ["SUPPORTED_DURING_VALIDITY", "NOT_ESTABLISHED", "UNKNOWN"] },
          "current_support": { "enum": ["ESTABLISHED", "NOT_ESTABLISHED", "UNKNOWN"] },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "missing_support": { "type": "array", "items": { "type": "string" } },
    "risk_gaps": { "type": "array", "items": { "type": "string" } },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "target_gaps", "cost_level", "action", "reason"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "target_gaps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["CURRENT_ISSUER_STATUS", "CURRENT_CERTIFICATE_OR_RENEWAL", "SUPERSESSION_OR_WITHDRAWAL", "CURRENT_PRODUCT_SCOPE_LINKAGE", "OTHER"]
            }
          },
          "cost_level": { "enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN"] },
          "action": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "final_policy_decision": { "enum": ["EXTERNAL_REQUIRED", "APPROVED", "REJECTED", "UNKNOWN"] },
    "summary": { "type": "string" }
  }
}
