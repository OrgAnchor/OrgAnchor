{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organchor.org/schemas/evidence-conflict-agent-submission.v0.1.json",
  "title": "OrgAnchor Evidence Conflict Agent Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "evaluation_time", "identity_continuity", "package_integrity", "package_health_status", "conflict_status", "claim_support", "claim_truth", "fraud_assessment", "evidence_assessment", "conflict_analysis", "risk_gaps", "next_checks", "artifact_refs", "final_policy_decision", "summary"],
  "properties": {
    "scenario_id": { "type": "string", "const": "manufacturing-conflicting-current-evidence-v1" },
    "evaluation_time": { "type": "string", "const": "2026-07-17T00:00:00Z" },
    "identity_continuity": { "type": "string", "enum": ["VERIFIED", "NOT_VERIFIED", "UNKNOWN"] },
    "package_integrity": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "package_health_status": { "type": "string", "enum": ["FRESH", "STALE_EVIDENCE", "EXPIRED_EVIDENCE", "UNKNOWN"] },
    "conflict_status": { "type": "string", "enum": ["ACTIVE_CONFLICT", "NO_CONFLICT", "UNKNOWN"] },
    "claim_support": { "type": "string", "enum": ["SUFFICIENT", "INSUFFICIENT", "CONFLICTED", "UNKNOWN"] },
    "claim_truth": { "type": "string", "enum": ["TRUE", "FALSE", "NOT_DETERMINED"] },
    "fraud_assessment": { "type": "string", "enum": ["ESTABLISHED", "NOT_ESTABLISHED", "UNKNOWN"] },
    "evidence_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "s_class", "provenance", "freshness", "subject_scope", "direction", "population_scope", "limitations"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "s_class": { "type": "string", "enum": ["S1", "S2", "S3", "UNKNOWN"] },
          "provenance": { "type": "string", "enum": ["VERIFIED", "NOT_VERIFIED", "UNKNOWN"] },
          "freshness": { "type": "string", "enum": ["CURRENT", "EXPIRED", "UNDATED", "UNKNOWN"] },
          "subject_scope": { "type": "string", "enum": ["MATCH", "PARTIAL", "MISMATCH", "UNKNOWN"] },
          "direction": { "type": "string", "enum": ["SUPPORTS", "CONTRADICTS", "NEUTRAL", "UNKNOWN"] },
          "population_scope": { "type": "string", "enum": ["LIMITED", "BROAD", "UNIVERSAL", "UNKNOWN"] },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "conflict_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_subject", "overlapping_time_window", "resolution_status", "why_not_resolved"],
      "properties": {
        "same_subject": { "type": "boolean" },
        "overlapping_time_window": { "type": "boolean" },
        "resolution_status": { "type": "string", "enum": ["UNRESOLVED", "RESOLVED", "UNKNOWN"] },
        "why_not_resolved": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_gaps": { "type": "array", "items": { "type": "string" } },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "target_gaps", "cost_level", "action", "reason"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "target_gaps": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["S2_ISSUER_SCOPE_AND_METHOD", "S3_PROVENANCE_AND_CUSTODY", "SUBJECT_BATCH_AND_TIME_ALIGNMENT", "BOUNDED_REPEAT_SAMPLING", "ORGANIZATION_RESPONSE_OR_CORRECTION", "OTHER"] } },
          "cost_level": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN"] },
          "action": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "final_policy_decision": { "type": "string", "enum": ["EXTERNAL_REQUIRED", "APPROVED", "REJECTED", "UNKNOWN"] },
    "summary": { "type": "string" }
  }
}
