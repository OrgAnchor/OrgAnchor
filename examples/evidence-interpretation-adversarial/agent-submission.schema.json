{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organchor.org/schemas/evidence-interpretation-agent-submission.v0.2.json",
  "title": "OrgAnchor Evidence Interpretation Agent Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "identity_continuity",
    "package_integrity",
    "claim_support",
    "claim_truth",
    "fraud_assessment",
    "s3_status",
    "evidence_assessment",
    "missing_support",
    "risk_gaps",
    "next_checks",
    "artifact_refs",
    "final_policy_decision",
    "summary"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "const": "manufacturing-signed-weak-evidence-v1"
    },
    "identity_continuity": {
      "type": "string",
      "enum": ["VERIFIED", "NOT_VERIFIED", "UNKNOWN"]
    },
    "package_integrity": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "claim_support": {
      "type": "string",
      "enum": ["SUFFICIENT", "INSUFFICIENT", "CONFLICTED", "UNKNOWN"]
    },
    "claim_truth": {
      "type": "string",
      "enum": ["TRUE", "FALSE", "NOT_DETERMINED"]
    },
    "fraud_assessment": {
      "type": "string",
      "enum": ["ESTABLISHED", "NOT_ESTABLISHED", "UNKNOWN"]
    },
    "s3_status": {
      "type": "string",
      "enum": ["PRESENT", "ABSENT", "UNKNOWN"]
    },
    "evidence_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "s_class", "relevance", "scope_match", "limitations"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "s_class": { "type": "string", "enum": ["S1", "S2", "S3", "UNKNOWN"] },
          "relevance": {
            "type": "string",
            "description": "Relevance to the exact claim under review, not to the product or organization generally. DIRECT measures or models the claimed outcome; INDIRECT bears on it through an explicit inference; IRRELEVANT does not address that claim.",
            "enum": ["DIRECT", "INDIRECT", "IRRELEVANT", "UNKNOWN"]
          },
          "scope_match": {
            "type": "string",
            "description": "Coverage of the exact claim's material outcome, subject, conditions, population, and time scope. PARTIAL addresses the claimed outcome but leaves part uncovered; MISMATCH assesses a different outcome or materially different scope.",
            "enum": ["MATCH", "PARTIAL", "MISMATCH", "UNKNOWN"]
          },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "missing_support": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "target_gaps", "cost_level", "action", "reason"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "target_gaps": {
            "description": "Every uncertainty gap addressed by this one action. Multiple values are allowed so combined actions remain explicit and machine-scorable.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "DIRECT_LIFETIME_TEST_SCOPE",
                "EXTRAPOLATION_AND_RAW_OBSERVATIONS",
                "SAMPLE_PRODUCT_BATCH_LINKAGE",
                "INDEPENDENT_OR_RANDOM_SAMPLE",
                "OTHER"
              ]
            }
          },
          "cost_level": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "UNKNOWN"] },
          "action": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "final_policy_decision": {
      "type": "string",
      "enum": ["EXTERNAL_REQUIRED", "APPROVED", "REJECTED", "UNKNOWN"]
    },
    "summary": {
      "type": "string"
    }
  }
}
