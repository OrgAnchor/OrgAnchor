{
  "name": "organchor",
  "version": "0.1.0-alpha.5",
  "description": "Signed organizational identity continuity toolchain.",
  "type": "module",
  "main": "dist/cli.js",
  "homepage": "https://organchor.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrgAnchor/OrgAnchor.git"
  },
  "bugs": {
    "url": "https://github.com/OrgAnchor/OrgAnchor/issues"
  },
  "bin": {
    "organchor": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/schema/",
    "scripts/agent-discovery-demo.mjs",
    "scripts/capability-audit.mjs",
    "scripts/capability-scenarios.mjs",
    "scripts/docs-audit.mjs",
    "scripts/evidence-interpretation-evaluation.mjs",
    "scripts/visible-acceptance-demo.mjs",
    "templates/",
    "examples/",
    "!examples/transaction-cost-benchmark/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DOCS_INDEX.md",
    "docs/",
    "!docs/history/",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "agent:demo": "node scripts/agent-discovery-demo.mjs",
    "capability:audit": "node scripts/capability-audit.mjs",
    "capability:scenarios": "node scripts/capability-scenarios.mjs",
    "check": "node --run typecheck && node --run test && node --run docs:audit",
    "docs:audit": "node scripts/docs-audit.mjs",
    "evaluation:evidence": "node scripts/evidence-interpretation-evaluation.mjs",
    "install:smoke": "node scripts/install-smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "node --run build",
    "release:check": "node --run check && node --run release:smoke && node --run package:smoke && node --run install:smoke",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "visible:demo": "node scripts/visible-acceptance-demo.mjs",
    "start": "node src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "alpha"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "24.12.3",
    "typescript": "5.9.3"
  }
}
